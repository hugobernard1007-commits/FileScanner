<Window x:Class="FolderAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:FolderAnalyzer.Converters"
        mc:Ignorable="d"
        Title="Folder Analyzer"
        Height="700"
        Width="1200">

    <Window.Resources>

        <conv:ConfidentialityBrushConverter
            x:Key="ConfBrush"/>
        <conv:InverseBooleanConverter
            x:Key="InverseBooleanConverter"/>

    </Window.Resources>

    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top">

            <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SelectedFolder}" />

                <Button Grid.Column="1"
                        Content="Parcourir"
                        Margin="5 0 0 0"
                        Command="{Binding BrowseCommand}" />
            </Grid>

            <StackPanel Orientation="Horizontal">

                <Button Content="Scanner"
                    Width="120"
                    Height="30"
                    Margin="0 0 10 0"
                    Command="{Binding ScanCommand}"
                    IsEnabled="{Binding IsScanning,
                    Converter={StaticResource InverseBooleanConverter}}" />

                <Button Content="Annuler"
                    Width="120"
                    Height="30"
                    Margin="0 0 10 0"
                    Command="{Binding CancelCommand}" 
                    IsEnabled="{Binding IsScanning}"/>

                <Button Content="Exporter CSV"
                         Width="120"
                         Height="30"
                         Command="{Binding ExportCommand}" />

            </StackPanel>

            <ProgressBar Height="25"
                Margin="0,10,0,10"
                Minimum="0"
                Maximum="100"
                Value="{Binding ProgressValue}" />

           <TextBlock Text="{Binding CurrentFile}"
           Margin="0,5,0,0"
           FontStyle="Italic" />

            <TextBlock Text="{Binding ProgressValue,
                        StringFormat=Progression : {0}%}"
                        FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0 10">

                <TextBlock Text="Nb fichiers : "
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding TotalFiles}"/>

                <TextBlock Text="     Taille totale : "
                           FontWeight="Bold"
                           Margin="20 0 0 0"/>

                <TextBlock Text="{Binding TotalSize}"/>

            </StackPanel>

        </StackPanel>

        <DataGrid ItemsSource="{Binding Files}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                EnableRowVirtualization="True"
                EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Nom"
                                    Binding="{Binding Name}"
                                    Width="200"/>

                <DataGridTextColumn Header="Extension"
                                    Binding="{Binding Extension}"
                                    Width="100"/>

                <DataGridTextColumn Header="Taille (octets)"
                                    Binding="{Binding Size}"
                                    Width="120"/>

                <DataGridTextColumn Header="Score"
                                    Binding="{Binding ConfidentialityScore}"
                                    Width="80"/>

                <!-- Colonne colorée -->
                <DataGridTemplateColumn Header="Confidentialité"
                                        Width="150">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Border Padding="4"
                                    Background="{Binding ConfidentialityScore,
                                                         Converter={StaticResource ConfBrush}}">

                                <TextBlock Text="{Binding ConfidentialityLevel}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"/>

                            </Border>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Création"
                                    Binding="{Binding CreationDate}"
                                    Width="180"/>

                <DataGridTextColumn Header="Modification"
                                    Binding="{Binding LastModifiedDate}"
                                    Width="180"/>

                <DataGridTextColumn Header="Attributs"
                                    Binding="{Binding Attributes}"
                                    Width="150"/>

                <DataGridTextColumn Header="Chemin"
                                    Binding="{Binding FullPath}"
                                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>

</Window> 